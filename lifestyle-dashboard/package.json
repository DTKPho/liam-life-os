{
  "name": "mon-lifestyle",
  "productName": "Mon Lifestyle",
  "version": "2.0.0",
  "description": "Dashboard de mon lifestyle : maisons, voitures, montres…",
  "repository": "github:DTKPho/liam-life-os",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never && electron-builder --mac dmg --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dtkpho.monlifestyle",
    "productName": "Mon Lifestyle",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "icon": "resources/icon.png",
      "target": [
        "dmg"
      ],
      "artifactName": "Mon-Lifestyle-${arch}.${ext}"
    },
    "dmg": {
      "title": "Mon Lifestyle"
    }
  }
}
